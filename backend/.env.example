# Backend environment variables.
#
# Copy to backend/.env to use locally:  cp .env.example .env
# NOTHING here is required for local development — every variable has a
# dev-safe default, and with no .env file at all the backend behaves exactly
# as it always has (SQLite, DEBUG on, localhost:3000 CORS).
#
# In production, set these on the host (Railway/Fly/Render/Docker `-e`), not
# in a committed file. `.env` is gitignored.

# --- Core ------------------------------------------------------------------

# Required when DEBUG=False; startup fails loudly without it.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True/False (also accepts 1/0, yes/no, on/off). Default: True.
# Setting this to False turns on the whole production hardening block
# (SSL redirect, HSTS, secure cookies, nosniff, proxy SSL header).
DEBUG=True

# Comma-separated hostnames. Default: localhost,127.0.0.1,192.168.1.156
# (the third entry is the dev-machine LAN IP used by Expo Go).
ALLOWED_HOSTS=localhost,127.0.0.1

# Path the Django admin is served from, without slashes (leading/trailing ones
# are stripped, so "ops/panel", "/ops/panel/" and "ops/panel" are the same).
# Default: admin, i.e. the usual /admin/ — so nothing needs setting locally.
#
# This is **obscurity, not security**: it does not harden the login form one
# bit, and anyone who learns the path is exactly where they were. What it does
# buy is real though — the constant background noise of bots probing /admin/,
# /admin/login/ and friends stops finding anything, so the login form is not
# exposed to drive-by credential stuffing and the logs stay readable. Note that
# the DRF throttles do NOT apply to the admin login form (it is a Django view,
# not a DRF one), which is part of why keeping scanners off it matters.
# Pick something unguessable in production, e.g. a random word plus digits.
ADMIN_URL=admin

# --- Database --------------------------------------------------------------

# Comma-free URL, parsed by dj-database-url. Default: the local SQLite file
# backend/db.sqlite3. Example Postgres value:
#   postgres://user:password@host:5432/dbname
DATABASE_URL=

# Seconds to keep a DB connection open (0 = close every request). Default: 600.
DB_CONN_MAX_AGE=600

# Force SSL on the DB connection. Default: False. Set True for hosted Postgres
# that requires it (most managed providers already put ?sslmode=require in the URL).
DB_SSL_REQUIRE=False

# --- Cache -----------------------------------------------------------------

# Redis connection URL, used for Django's cache — which is where DRF keeps its
# rate-limit counters. Default: unset, meaning an in-process LocMemCache.
#
# The caveat that makes this worth setting in production: LocMemCache is
# per-process and per-restart, so with gunicorn every rate below is enforced
# once *per worker*. At the default WEB_CONCURRENCY=3 a "10/hour" login limit
# behaves like ~30/hour, and every deploy resets the counters to zero. Point
# REDIS_URL at a shared Redis and the limits become global and survive
# restarts. Requires the pinned `redis` package (it is in requirements.txt).
#   redis://default:password@host:6379/0     (Railway injects this shape)
#   rediss://...                             (TLS)
REDIS_URL=

# --- CORS / CSRF -----------------------------------------------------------

# Comma-separated origins, scheme included. Defaults keep the React dev server
# (http://localhost:3000) working out of the box.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Rate limiting (DRF throttling) ---------------------------------------

# Rates use DRF syntax: "<number>/<second|minute|hour|day>".
# All of them are disabled automatically while running `manage.py test`.
# Everything but `anon`/`user` is a scoped throttle attached to a specific auth
# view. `refresh` is deliberately generous — both clients hit
# /api/auth/refresh/ automatically whenever an access token 401s.
# `password_reset` is tight because that endpoint mails a third party: loose,
# it is both an account-enumeration probe and a way to spam someone's inbox.
THROTTLE_RATE_ANON=120/min
THROTTLE_RATE_USER=240/min
THROTTLE_RATE_LOGIN=10/hour
THROTTLE_RATE_REGISTER=5/hour
THROTTLE_RATE_REFRESH=60/hour
THROTTLE_RATE_PASSWORD_RESET=5/hour
THROTTLE_RATE_PASSWORD_RESET_CONFIRM=20/hour

# --- Inactivity forfeit ----------------------------------------------------

# Hours a player may leave the game waiting on them before the opponent can
# claim the win via POST /api/games/{id}/claim_timeout/. Default: 48.
#
# The clock starts when the seat *becomes* the one owed an action (a join, a
# confirmed turn, a double offered or taken, a new game in a match) and is
# deliberately NOT restarted by rolling the dice — otherwise a player could
# roll and then stall indefinitely on a fresh deadline. Claims are pull-based:
# nothing sweeps in the background, the opponent has to ask. Registered seats
# only — a guest seat has no identity to verify against.
TURN_TIMEOUT_HOURS=48

# How close to that deadline a player gets a "your clock is running" email.
# Default: 12, i.e. three quarters of the way through a 48-hour window.
#
# Nothing sends these on its own — there is no Celery and no in-process cron.
# A platform scheduler has to run the command, which is safe to call as often
# as every few minutes:
#   python manage.py send_turn_reminders            (add --dry-run to preview)
# Exactly one reminder is sent per turn (tracked on Game.turn_reminder_sent_at,
# cleared whenever the turn flips), and only for seats that are registered
# accounts with an email address on file. With EMAIL_HOST unset the mail is
# printed to stdout by the console backend, so this needs no configuration to
# try locally.
TURN_REMINDER_LEAD_HOURS=12

# --- Email (password reset and turn reminders) -----------------------------

# Plain SMTP, so any provider works — SES, Postmark, Resend, Mailgun, Gmail.
# Default: EMAIL_HOST unset, which selects Django's **console** backend and
# prints outgoing mail (including the reset link) to stdout. Local development
# therefore needs no mail account anywhere; set EMAIL_HOST to switch to real
# SMTP delivery.
EMAIL_HOST=
# Default: 587 (STARTTLS). Providers that want implicit TLS on 465 are not
# supported by EMAIL_USE_TLS alone — prefer the 587 endpoint they all offer.
EMAIL_PORT=587
# Credentials from the provider. For SES these are the SMTP-specific
# credentials, not your AWS access key.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS. Default: True. Leave it on for any real provider.
EMAIL_USE_TLS=True
# From-address on outgoing mail (password resets, turn reminders). Must be an
# address the provider has
# verified, or delivery is rejected. Default: Backgammon <no-reply@localhost>.
DEFAULT_FROM_EMAIL=Backgammon <no-reply@localhost>

# --- Client origin ---------------------------------------------------------

# Where the *web client* is served from. Used to build the links in outgoing
# mail:
#   {FRONTEND_BASE_URL}/reset-password/{uid}/{token}   (password reset)
#   {FRONTEND_BASE_URL}/game/{id}                      (turn reminder)
# The backend cannot infer this (the client is a different origin), so a
# deployed backend must set it or every emailed link will point at localhost.
# Default: http://localhost:3000. Trailing slashes are stripped.
FRONTEND_BASE_URL=http://localhost:3000

# --- Production toggles (only take effect when DEBUG=False) ----------------

# Redirect HTTP -> HTTPS. Default: True. Set False only if something in front
# of the app already does it and the redirect would loop.
SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds. Default: 31536000 (1 year), with includeSubDomains
# and preload. Use a small value (e.g. 60) while first testing a domain.
SECURE_HSTS_SECONDS=31536000

# --- Logging ---------------------------------------------------------------

# Root/django/game log level: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# django.request is pinned to WARNING whenever DEBUG=False.
LOG_LEVEL=INFO

# --- Error monitoring ------------------------------------------------------

# Sentry DSN. Default: unset, and with no DSN `sentry_sdk.init()` is never
# called at all — no import cost, no network, zero behaviour change. Sentry is
# also skipped unconditionally while running `manage.py test`.
SENTRY_DSN=

# Tag applied to every event. Default: "development" when DEBUG=True,
# "production" otherwise. Override to distinguish staging from production.
SENTRY_ENVIRONMENT=

# Release identifier, so a regression can be pinned to a deploy. Default: the
# value of RAILWAY_GIT_COMMIT_SHA if the host injects it, else unset.
SENTRY_RELEASE=

# Performance-tracing sample rate, 0.0–1.0. Default: 0 (errors only).
SENTRY_TRACES_SAMPLE_RATE=0

# Comma-separated recipients for Django's own 500 emails, as
# "Name <addr@example.com>" or a bare address. Default: empty, and while it is
# empty no mail_admins handler is attached to django.request at all. Setting it
# only helps if an EMAIL_* / SMTP backend is configured — Sentry is the
# lower-friction option of the two.
ADMINS=

# From-address on those emails. Default: root@localhost.
SERVER_EMAIL=root@localhost

# --- Serving (read by gunicorn via Procfile/Dockerfile, not by Django) -----

# Port to bind. Most hosts inject this themselves. Default: 8000.
PORT=8000
# Gunicorn worker processes. Default: 3.
WEB_CONCURRENCY=3
