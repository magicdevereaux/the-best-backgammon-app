# Backend environment variables.
#
# Copy to backend/.env to use locally:  cp .env.example .env
# NOTHING here is required for local development — every variable has a
# dev-safe default, and with no .env file at all the backend behaves exactly
# as it always has (SQLite, DEBUG on, localhost:3000 CORS).
#
# In production, set these on the host (Railway/Fly/Render/Docker `-e`), not
# in a committed file. `.env` is gitignored.

# --- Core ------------------------------------------------------------------

# Required when DEBUG=False; startup fails loudly without it.
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True/False (also accepts 1/0, yes/no, on/off). Default: True.
# Setting this to False turns on the whole production hardening block
# (SSL redirect, HSTS, secure cookies, nosniff, proxy SSL header).
DEBUG=True

# Comma-separated hostnames. Default: localhost,127.0.0.1,192.168.1.156
# (the third entry is the dev-machine LAN IP used by Expo Go).
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------

# Comma-free URL, parsed by dj-database-url. Default: the local SQLite file
# backend/db.sqlite3. Example Postgres value:
#   postgres://user:password@host:5432/dbname
DATABASE_URL=

# Seconds to keep a DB connection open (0 = close every request). Default: 600.
DB_CONN_MAX_AGE=600

# Force SSL on the DB connection. Default: False. Set True for hosted Postgres
# that requires it (most managed providers already put ?sslmode=require in the URL).
DB_SSL_REQUIRE=False

# --- CORS / CSRF -----------------------------------------------------------

# Comma-separated origins, scheme included. Defaults keep the React dev server
# (http://localhost:3000) working out of the box.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Rate limiting (DRF throttling) ---------------------------------------

# Rates use DRF syntax: "<number>/<second|minute|hour|day>".
# All five are disabled automatically while running `manage.py test`.
# `login`, `register` and `refresh` are scoped throttles attached to the auth
# views. `refresh` is deliberately generous — both clients hit
# /api/auth/refresh/ automatically whenever an access token 401s.
THROTTLE_RATE_ANON=120/min
THROTTLE_RATE_USER=240/min
THROTTLE_RATE_LOGIN=10/hour
THROTTLE_RATE_REGISTER=5/hour
THROTTLE_RATE_REFRESH=60/hour

# --- Production toggles (only take effect when DEBUG=False) ----------------

# Redirect HTTP -> HTTPS. Default: True. Set False only if something in front
# of the app already does it and the redirect would loop.
SECURE_SSL_REDIRECT=True

# HSTS max-age in seconds. Default: 31536000 (1 year), with includeSubDomains
# and preload. Use a small value (e.g. 60) while first testing a domain.
SECURE_HSTS_SECONDS=31536000

# --- Logging ---------------------------------------------------------------

# Root/django/game log level: DEBUG, INFO, WARNING, ERROR. Default: INFO.
# django.request is pinned to WARNING whenever DEBUG=False.
LOG_LEVEL=INFO

# --- Serving (read by gunicorn via Procfile/Dockerfile, not by Django) -----

# Port to bind. Most hosts inject this themselves. Default: 8000.
PORT=8000
# Gunicorn worker processes. Default: 3.
WEB_CONCURRENCY=3
