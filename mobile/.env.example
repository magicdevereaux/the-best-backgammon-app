# Copy to `mobile/.env` and edit. Expo SDK 49+ inlines every EXPO_PUBLIC_*
# variable into the JS bundle at build time, so this value is baked into the
# app — never put secrets here.

# Base URL of the Django backend, absolute and without a trailing slash.
# The app appends paths like `/api/games/` to it.
#
#   Development : leave UNSET. Expo Go / dev-client auto-detect the dev-machine
#                 LAN IP from Metro, which is what makes "npm start, scan the QR
#                 code" work on a physical device with zero configuration.
#                 Set it only to point a dev build at a different backend.
#   Release     : REQUIRED, and must be https://. There is no Metro host in a
#                 store build, and plaintext http:// is blocked by iOS App
#                 Transport Security and Android's default
#                 usesCleartextTraffic=false (targetSdk >= 28).
#
# Resolution order (first non-empty wins):
#   MANUAL_OVERRIDE in src/api/config.js > EXPO_PUBLIC_API_URL >
#   expo.extra.apiUrl in app.json > Metro hostUri (dev only) > loopback (dev only)
#
# For EAS builds, prefer setting this in the profile's `env` block in eas.json
# (or as an EAS environment variable) so CI builds don't depend on a local file.
EXPO_PUBLIC_API_URL=https://api.example.com
