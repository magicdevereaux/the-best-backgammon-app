# Copy to .env.local (git-ignored) and adjust as needed.
# Only variables prefixed with REACT_APP_ are exposed to the bundle by Create
# React App, and their values are inlined at BUILD time — rebuild after a change.

# Origin of the Django API.
#
# Local development: leave this EMPTY (or omit the file entirely). Requests then
# stay root-relative (`/api/...`) and the CRA dev-server proxy in package.json
# forwards them to http://localhost:8000.
#
# Production build: set it to the API origin, e.g.
#   REACT_APP_API_BASE_URL=https://api.example.com
# A trailing slash is tolerated and stripped, so `https://api.example.com/`
# works too. Do not include the `/api` path segment — the client adds it.
REACT_APP_API_BASE_URL=
